<Page x:Class="unloadSchedule.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:unloadSchedule"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="600"
      Title="Main">
    <Grid Background="#231942">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="unloadName" Grid.ColumnSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
        <Button x:Name="settingsBtn" Grid.ColumnSpan="4" Height="Auto" Width="Auto" Grid.Row="1" Content="Настройки" Margin="0,8,0,5" Command="{Binding GotoSettingsCommand}"/>
        <RadioButton x:Name="partialUnload" Grid.Row="1" Content="Выгрузка 1 день" IsChecked="True" Foreground="White" Margin="0,43,0,9" Grid.RowSpan="2"/>
        <RadioButton x:Name="fullUnload" Grid.Column="1" Grid.Row="1" Content="Полная выгрузка" IsChecked="False" Foreground="White" Margin="0,43,0,9" Grid.RowSpan="2"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="Запланировать" Margin="5,6,55,11" Foreground="White"/>
        <ToggleButton  x:Name="scheduledUnload" Grid.Column="2" Grid.Row="1" Margin="106,42,10,2" Grid.RowSpan="2" Checked="scheduledUnload_Checked" Unchecked="scheduledUnload_Unchecked"/>
        <DatePicker x:Name="datePicker" Grid.Column="3" Grid.Row="2" IsEnabled="False" Language="Ru" Foreground="White" Margin="70,0,0,13"/>
        <md:TimePicker x:Name="timeReserv" Grid.Column="3" Grid.Row="2" IsEnabled="False" Is24Hours="True"  Foreground="White" Margin="0,0,85,13"/>
        <Button x:Name="unloadBtn" Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="2" Command="{Binding UploadCommand}" Content="Начать" VerticalAlignment="Top" Margin="0,29,0,0" Grid.RowSpan="2"/>
        <TextBlock x:Name="latestFile" Grid.Row="4" Grid.Column="2" Text="{Binding CurrentFile}" TextAlignment="Center" Foreground="White" VerticalAlignment="Top"/>
        <ProgressBar x:Name="progressBar" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,30,35"/>
        <TextBlock x:Name="percentCount" Grid.Row="3" Grid.Column="1" Text="0%" TextAlignment="Center" Foreground="White" Margin="120,34,0,4" Grid.RowSpan="2"/>
        <TextBlock x:Name="latestTime" Grid.Row="4" Grid.Column="3" Text="{Binding ElapsedTime}" TextAlignment="Center" Foreground="White" Margin="0,0,0,25"/>
        <TextBlock x:Name="unloadList" Grid.Row="5" Grid.Column="0" Text="Запланировано:" Foreground="White" HorizontalAlignment="Center" Height="20" VerticalAlignment="Center" Visibility="Collapsed"/>
        <TextBlock x:Name="FirstList" Grid.Row="5" Grid.Column="1" Text="1." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Visibility="Collapsed"/>
        <TextBlock x:Name="SecondList" Grid.Row="5" Grid.Column="2" Text="2." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Visibility="Collapsed"/>
        <TextBlock x:Name="ThirdList" Grid.Row="5" Grid.Column="3" Text="3." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Visibility="Collapsed"/>
        <Frame x:Name="settingsFrame" Panel.ZIndex="100" Height="100"/>
    </Grid>
</Page>
