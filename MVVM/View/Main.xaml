<Page x:Class="unloadSchedule.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:unloadSchedule" xmlns:viewmodel="clr-namespace:unloadSchedule.MVVM.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:SettingsViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="600"
      Title="Main">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Background="#231942">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="scheduleName" Text="{Binding ScheduleName}" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="5 0 0 0"/>
        <TextBlock x:Name="unloadName" Grid.ColumnSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
        <Button x:Name="settingsBtn" Grid.ColumnSpan="4" Grid.Row="1" Content="Настройки" Command="{Binding GotoSettingsCommand}"/>
        <RadioButton x:Name="partialUnload" Grid.Row="2" Content="Выгрузка 1 день" Margin="0 0 0 15" IsChecked="{Binding unloadTomorrow}" Foreground="White"/>
        <RadioButton x:Name="fullUnload" Grid.Column="1" Grid.Row="2" Content="Полная выгрузка" Margin="0 0 0 15" IsChecked="{Binding unloadFull}" Foreground="White"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="Запланировать" Foreground="White" Margin="0 3 60 12"/>
        <ToggleButton  x:Name="scheduledUnload" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Right" Margin="0 2 9 13"  IsChecked="{Binding IsScheduled, Mode=TwoWay}"
            Command="{Binding ScheduleIsChecked}" Width="50"/>
        <DatePicker x:Name="datePicker" Grid.Column="3" Grid.Row="2" IsEnabled="{Binding DatePickerIsEnabled}" Text="{Binding DatePickerText}" Language="Ru" Foreground="White" Width="75" Height="25" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 0 10"/>
        <md:TimePicker x:Name="timeReserv" Grid.Column="3" Grid.Row="2" IsEnabled="{Binding TimeReservIsEnabled}" Is24Hours="True" Text="{Binding TimeReservText}"  Foreground="White" Width="70" Height="25" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0 0 0 10"/>
        <Button x:Name="unloadBtn" Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="2" Command="{Binding UploadCommand}" Content="Начать" VerticalAlignment="Top" Margin="0,29,0,0" Grid.RowSpan="2"/>
        <TextBlock x:Name="latestFile" Grid.Row="4" Grid.Column="2" Text="{Binding CurrentFile}" TextAlignment="Center" Foreground="White" VerticalAlignment="Top"/>
        <ProgressBar x:Name="progressBar" Value ="{Binding UploadProgress}" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,30,35"/>
        <TextBlock x:Name="percentCount" Grid.Row="4" Grid.Column="1" Text="{Binding UploadPercentage}" TextAlignment="Center" Foreground="White" Margin="122,0,148,3" Grid.ColumnSpan="2"/>
        <TextBlock x:Name="latestTime" Grid.Row="4" Grid.Column="3" Text="{Binding ElapsedTime}" TextAlignment="Center" Foreground="White" Margin="0,0,0,25"/>
        <TextBlock x:Name="unloadList" Grid.Row="5" Grid.Column="0" Text="Запланировано:" Foreground="White" HorizontalAlignment="Center" Height="20" VerticalAlignment="Center" Visibility="{Binding UnloadListVisibility, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <TextBlock x:Name="FirstList" Grid.Row="5" Grid.Column="1" Text="1." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Visibility="{Binding FirstListVisibility, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <TextBlock x:Name="SecondList" Grid.Row="5" Grid.Column="2" Text="2." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Visibility="{Binding SecondListVisbility, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <TextBlock x:Name="ThirdList" Grid.Row="5" Grid.Column="3" Text="3." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Visibility="{Binding ThirdListVisibility, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <Frame x:Name="settingsFrame" Panel.ZIndex="100" Height="100"/>
    </Grid>
</Page>
