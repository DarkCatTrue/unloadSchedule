<Page x:Class="unloadSchedule.MVVM.View.QueuePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:unloadSchedule.MVVM.View"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="450"
      Title="QueuePage">
    <Grid Background="#828282">
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" 
                 SelectedItem="{Binding SelectedItem}"
                 AutoGenerateColumns="False" Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="День расписания" Binding="{Binding FirstPart}" IsReadOnly="True"/>

                <DataGridTextColumn Header="Дата" Binding="{Binding SecondPart, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Время" Binding="{Binding ThirdPart, UpdateSourceTrigger=PropertyChanged}"/>

                <DataGridTemplateColumn Header="Действие">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Сохранить" 
                        Command="{Binding DataContext.SaveRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding IsEdited}"
                        Margin="0,0,5,0"
                        Padding="5,2"/>

                                <Button Content="Удалить"
                        Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}"
                        Padding="5,2"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
