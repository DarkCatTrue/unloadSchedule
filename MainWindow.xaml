        <Image Margin="524,-4,42,258" x:Name="colapseBtn" Source="/Icons/Знак_свернуть.png" Panel.ZIndex="10" MouseDown="colapseBtn_MouseDown"/>
        <Frame Source="/Pages/Main.xaml" x:Name="mainFrame" Panel.ZIndex="1" Margin="-2,-5,0,0" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
