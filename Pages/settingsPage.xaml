<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:unloadSchedule"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" x:Class="unloadSchedule.settingsPage"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="600"
      Title="settingsPage">
    <Grid Background="#231942">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="mainMenu" Grid.ColumnSpan="2" Grid.Row="1" Content="Основное меню" VerticalAlignment="Center" Click="mainMenu_Click"/>
        <TextBlock Grid.Row="2" Text="Путь к папке с расписанием" TextAlignment="Center" Foreground="White" Margin="0,4,0,21" Grid.RowSpan="2"/>
        <TextBlock Grid.Row="3" Text="ip" TextAlignment="Center" Foreground="White" Margin="0,4,0,21" Grid.RowSpan="2"/>
        <TextBlock Grid.Row="4" Text="Логин" TextAlignment="Center" Foreground="White" Margin="0,4,0,21" Grid.RowSpan="2"/>
        <TextBlock Grid.Row="5" Text="Пароль" TextAlignment="Center" Foreground="White" Margin="0,4,0,41" Grid.RowSpan="2"/>
        <TextBox x:Name="pathBox" Grid.Column="1" Grid.Row="2" TextAlignment="Center" Foreground="White"/>
        <TextBox x:Name="ipBox" Grid.Column="1" Grid.Row="3" TextAlignment="Center" Foreground="White"/>
        <TextBox x:Name="loginBox" Grid.Column="1" Grid.Row="4" TextAlignment="Center" Foreground="White"/>
        <PasswordBox x:Name="passwordBox" Grid.Column="1" Grid.Row="5" HorizontalContentAlignment="Center" Foreground="White" PasswordChar="*"/>
        <Button x:Name="saveBtn" Grid.Row="6" Grid.ColumnSpan="2" Content="Сохранить" VerticalAlignment="Center"/>
    </Grid>
</Page>
